---
permalink: /index.html
---
{%- set s = site -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ s.meta.title }}</title>
  <meta name="description" content="{{ s.meta.description }}">
  <meta name="theme-color" content="#1f2328">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;700&family=Frank+Ruhl+Libre:wght@400;500;700&family=Libre+Caslon+Text:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav" id="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top">{{ s.meta.brand }}</a>
      <p class="bsd" lang="he" dir="rtl">בס״ד</p>
      <a class="nav-join" href="#join">{{ s.nav.cta }}</a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
        <span></span><span></span>
      </button>
      <nav id="nav-links" class="nav-links">
        <a href="#why">{{ s.nav.why }}</a>
        <a href="#process">{{ s.nav.process }}</a>
        <a href="#numbers">{{ s.nav.numbers }}</a>
        <a href="#vision">{{ s.nav.vision }}</a>
        <a class="nav-cta" href="#join">{{ s.nav.cta }}</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {%- set h = s.hero %}
    <section class="hero" id="top">
      <figure class="hero-media">
        <div class="hero-img" style="--img: url('{{ h.image }}')" role="img" aria-label="Illustrative view of terraced olive groves in the hills"></div>
        {%- if h.image_note %}<figcaption class="img-note">{{ h.image_note }}</figcaption>{% endif %}
      </figure>
      <div class="hero-body">
        <h1>{{ h.title }}</h1>
        <p class="hero-sub">{{ h.subtitle | md | safe }}</p>
        <div class="hero-cta">
          <a class="btn btn-solid" href="#join">{{ h.cta_primary }}</a>
          <a class="btn btn-line" href="{{ s.meta.brochure }}" download>{{ h.cta_secondary }}</a>
        </div>
      </div>
    </section>

    {%- set x = s.counters %}
    {%- if x.items.length %}
    <section class="counters" aria-labelledby="counters-title">
      <div class="wrap">
        <h2 id="counters-title" class="counters-title">{{ x.title }}</h2>
        <dl class="counters-list">
          {%- for item in x.items %}
          <div class="counter"><dt>{{ item.label }}</dt><dd class="count" data-to="{{ item.value }}"{% if item.source and item.source != 'manual' %} data-source="{{ item.source }}"{% endif %}>{{ item.value }}</dd></div>
          {%- endfor %}
        </dl>
        <p class="counters-asof">{{ x.as_of }}</p>
      </div>
    </section>
    {%- endif %}

    <section class="statement">
      <div class="wrap statement-inner">
        <p class="statement-he" lang="he" dir="rtl">{{ h.pasuk }}</p>
        <p class="statement-en">{{ h.pasuk_en }}</p>
        <p class="statement-src">{{ h.pasuk_source }}</p>
        <p class="statement-yi" lang="yi" dir="rtl">{{ h.yiddish }}</p>
      </div>
    </section>

    {%- set x = s.history %}
    <section class="section">
      <div class="wrap split">
        <div class="split-head">
          <h2>{{ x.title }}</h2>
          <p class="lede">{{ x.lede }}</p>
        </div>
        <div>
          <ol class="timeline">
            {%- for item in x.items %}
            <li><span class="year" lang="he">{{ item.year }}</span><p>{{ item.text | md | safe }}</p></li>
            {%- endfor %}
          </ol>
          <p class="closing-line">{{ x.kicker }} {{ x.kicker_accent }}</p>
        </div>
      </div>
    </section>

    {%- set x = s.today %}
    <section class="section band-soft">
      <div class="wrap">
        <h2 class="center-head">{{ x.title }}</h2>
        <div class="figures">
          {%- for stat in x.stats %}
          <p class="figure"><strong class="tnum">{{ stat.value }}</strong> {{ stat.text | md | safe }}</p>
          {%- endfor %}
        </div>
        <div class="grade">
          <h3><span class="tnum">{{ x.grade_value }}</span> {{ x.grade_title }}</h3>
          {%- for bar in x.bars %}
          <div class="bar-row"><span class="tnum">{{ bar.year }}</span><div class="bar"><i class="b-sec" style="--w:{{ bar.secular }}%">{{ bar.secular }}%</i><i class="b-dati" style="--w:{{ bar.dati }}%">{{ bar.dati }}%</i><i class="b-char" style="--w:{{ bar.chareidi }}%">{{ bar.chareidi }}%</i></div></div>
          {%- endfor %}
          <p class="legend"><span class="k b-sec"></span>{{ x.legend_secular }} <span class="k b-dati"></span>{{ x.legend_dati }} <span class="k b-char"></span>{{ x.legend_chareidi }}</p>
        </div>
        <p class="closing-line center">{{ x.kicker }} {{ x.kicker_accent }}</p>
        <p class="sources">{{ x.sources }}</p>
      </div>
    </section>

    {%- set x = s.landscape %}
    {%- if x and x.image %}
    <figure class="plate">
      <img src="{{ x.image }}" alt="{{ x.caption }}" loading="lazy" width="2400" height="1152">
      {%- if x.caption %}<figcaption class="wrap">{{ x.caption }}</figcaption>{% endif %}
    </figure>
    {%- endif %}

    {%- set x = s.challenges %}
    <section class="section" id="why">
      <div class="wrap">
        <div class="section-intro">
          <h2>{{ x.title }}</h2>
          <p class="lede">{{ x.lede }}</p>
        </div>
        <div class="ledger">
          <div class="ledger-row ledger-head" aria-hidden="true"><span>&nbsp;</span><span>The challenge</span><span>{{ x.answer_label }}</span></div>
          {%- for item in x.items %}
          <article class="ledger-row">
            <h3>{{ item.title }}</h3>
            <p class="problem">{{ item.problem | md | safe }}</p>
            <p class="answer">{{ item.answer | md | safe }}</p>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>

    {%- set x = s.mission %}
    <section class="feature">
      <figure class="feature-media">
        <div class="feature-img" style="--img: url('{{ x.image }}')" role="img" aria-label="{{ x.image_caption }}"></div>
        {%- if x.image_caption %}<figcaption>{{ x.image_caption }}</figcaption>{% endif %}
      </figure>
      <div class="feature-text">
        <h2>{{ x.eyebrow }}</h2>
        {%- for item in x.items %}
        <div class="feature-item"><h3>{{ item.title }}</h3><p>{{ item.text | md | safe }}</p></div>
        {%- endfor %}
      </div>
    </section>

    {%- set x = s.process %}
    <section class="section" id="process">
      <div class="wrap">
        <div class="section-intro">
          <h2>{{ x.title }}</h2>
        </div>
        <ol class="stages">
          {%- for stage in x.stages %}
          <li class="stage">
            <div class="stage-mark"><span lang="he">{{ stage.letter }}</span>{{ stage.label }}</div>
            <div class="stage-body">
              <h3>{{ stage.title }}</h3>
              {%- if stage.lede %}<p class="stage-lede">{{ stage.lede }}</p>{% endif %}
              {%- if stage.intro %}<p class="stage-intro">{{ stage.intro | md | safe }}</p>{% endif %}
              <div class="points{% if stage.cards.length == 2 %} points-2{% endif %}">
                {%- for card in stage.cards %}
                <div class="point point-{{ card.style }}">
                  {%- if card.title %}<h4>{{ card.title }}{% if card.tag %} <span class="point-status">{{ card.tag }}</span>{% endif %}</h4>{% elif card.tag %}<h4>{{ card.tag }}</h4>{% endif %}
                  {%- if card.big %}<p class="point-big tnum">{{ card.big }}</p>{% endif %}
                  <p>{{ card.text | md | safe }}</p>
                </div>
                {%- endfor %}
              </div>
              {%- if stage.note %}<p class="note">{{ stage.note }}</p>{% endif %}
            </div>
          </li>
          {%- endfor %}
        </ol>
      </div>
    </section>

    {%- set x = s.numbers %}
    <section class="section numbers" id="numbers">
      <div class="wrap">
        <div class="section-intro">
          <h2>{{ x.title }}</h2>
        </div>
        <div class="adv">
          {%- for item in x.advantages %}
          <div><h3>{{ item.title }}</h3><p>{{ item.text | md | safe }}</p></div>
          {%- endfor %}
        </div>

        <div class="compare">
          <h3 class="compare-title">{{ x.compare_label }}</h3>
          <div class="cmp-row">
            <p class="cmp-label">{{ x.founder_title }} <span>{{ x.founder_sub }}</span></p>
            <div class="cmp-track"><div class="cmp-bar founder" style="--w:{{ x.founder_bar_percent }}%"></div><strong class="tnum">{{ x.founder_amount }} <small>{{ x.founder_amount_usd }}</small></strong></div>
          </div>
          <div class="cmp-row">
            <p class="cmp-label">{{ x.later_title }} <span>{{ x.later_sub }}</span></p>
            <div class="cmp-track"><div class="cmp-bar later" style="--w:100%"></div><strong class="tnum">{{ x.later_amount }}</strong></div>
          </div>
          <p class="fine">{{ x.compare_note }}</p>
        </div>

        <div class="allin">
          <p class="allin-value tnum">{{ x.allin_value }}</p>
          <div>
            <h3>{{ x.allin_label }}: {{ x.allin_title }}</h3>
            <p>{{ x.allin_text | md | safe }}</p>
            {%- if x.allin_yiddish %}<p class="yi" lang="yi" dir="rtl">{{ x.allin_yiddish }}</p>{% endif %}
          </div>
        </div>
      </div>
    </section>

    {%- set x = s.vision %}
    <section class="vision" id="vision">
      <figure class="vision-figure">
        <img src="{{ x.image }}" alt="Illustrative concept of the moshav: stone homes, a beis medrash and gardens among olive trees" loading="lazy" width="3200" height="898">
        {%- if x.image_caption %}<figcaption class="wrap">{{ x.image_caption }}</figcaption>{% endif %}
      </figure>
      <div class="wrap vision-text">
        <div class="section-intro">
          <h2>{{ x.title }} {{ x.title_accent }}</h2>
          <p class="lede">{{ x.text }}</p>
        </div>
        <h3 class="ideas-title">{{ x.ideas_label }}</h3>
        <div class="ideas">
          {%- for idea in x.ideas %}
          <div><h4>{{ idea.title }}</h4><ul>
            {%- for li in idea.items %}<li>{{ li }}</li>{% endfor -%}
          </ul></div>
          {%- endfor %}
        </div>
        <div class="voice">
          <h3>{{ x.voice_title }}</h3>
          <p>{{ x.voice_text | md | safe }}</p>
        </div>
      </div>
    </section>

    {%- set x = s.join %}
    {%- set f = s.form %}
    <section class="join" id="join">
      <div class="wrap">
        <div class="section-intro">
          <h2>{{ x.title }}</h2>
          <p class="lede">{{ x.lede }}</p>
          {%- if x.eyebrow_yiddish %}<p class="join-yi" lang="yi" dir="rtl">{{ x.eyebrow_yiddish }}</p>{% endif %}
        </div>

        <div class="who">
          {%- for item in x.who %}
          <div><h3>{{ item.title }}</h3><p>{{ item.text | md | safe }}</p></div>
          {%- endfor %}
        </div>
        <p class="who-note">{{ x.who_note }}</p>

        <div class="garin" data-committed="{{ x.garin_committed }}" data-goal="{{ x.garin_goal }}">
          <div class="garin-head"><h3>{{ x.garin_title }}</h3><p><strong class="tnum" data-live="families">{{ x.garin_committed }}</strong> {{ x.garin_committed_label }}</p></div>
          <div class="garin-grid" aria-hidden="true"></div>
          {%- if x.garin_legend %}<p class="garin-legend">{{ x.garin_legend }}</p>{% endif %}
        </div>

        <div class="join-grid">
          <div class="join-side">
            <ol class="ways">
              {%- for way in x.ways %}
              <li><span lang="he">{{ way.letter }}</span><div><h4>{{ way.title }}</h4><p>{{ way.text }}</p></div></li>
              {%- endfor %}
            </ol>
            <div class="contact">
              <h3>{{ x.contact_label }}</h3>
              <a class="email" href="mailto:{{ x.email }}">{{ x.email }}</a>
              <p>{{ x.phone_text }} · <a href="tel:+1{{ x.phone | replace('-', '') }}">{{ x.phone }}</a></p>
              {%- if x.whatsapp_number %}
              <a class="text-link" href="https://wa.me/{{ x.whatsapp_number }}" target="_blank" rel="noopener">{{ x.whatsapp_label }}</a>
              {%- endif %}
            </div>
          </div>

          <form class="form" name="join" method="POST" action="/api/join" novalidate
                data-success="{{ f.success }}" data-error="{{ f.error }}">
            <input type="hidden" name="t">
            <p class="hidden-field"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
            <h3>{{ f.title }}</h3>

            <fieldset class="form-part">
              <legend class="sr-only">{{ f.section_family }}</legend>
              <label>{{ f.family_name }}<input type="text" name="family_name" autocomplete="family-name" required></label>
              <div class="row row-age">
                <label>{{ f.husband_name }}<input type="text" name="husband_name"></label>
                <label>{{ f.husband_age }}<input type="number" name="husband_age" min="16" max="99" inputmode="numeric"></label>
              </div>
              <label>{{ f.husband_occupation }}<input type="text" name="husband_occupation"></label>
              <div class="row row-age">
                <label>{{ f.wife_name }}<input type="text" name="wife_name"></label>
                <label>{{ f.wife_age }}<input type="number" name="wife_age" min="16" max="99" inputmode="numeric"></label>
              </div>
              <label>{{ f.wife_occupation }}<input type="text" name="wife_occupation"></label>
            </fieldset>

            <fieldset class="form-part">
              <legend>{{ f.section_contact }}</legend>
              <div class="row">
                <label>{{ f.country }}
                  <select name="country" required>
                    <option value="">{{ f.situation_placeholder }}</option>
                    {%- for opt in f.country_options %}
                    <option>{{ opt }}</option>
                    {%- endfor %}
                  </select>
                </label>
                <label>{{ f.city }}<input type="text" name="city" autocomplete="address-level2"></label>
              </div>
              <div class="row">
                <label>{{ f.phone }}<input type="tel" name="phone" autocomplete="tel" required></label>
                <label>{{ f.email }}<input type="email" name="email" autocomplete="email" required></label>
              </div>
            </fieldset>

            <fieldset class="form-part">
              <legend>{{ f.section_children }}</legend>
              <div class="row row-count">
                <label>{{ f.boys }}<input type="number" name="boys" min="0" max="20" inputmode="numeric"></label>
                <label>{{ f.boys_ages }}<input type="text" name="boys_ages" placeholder="{{ f.ages_placeholder }}"></label>
              </div>
              <div class="row row-count">
                <label>{{ f.girls }}<input type="number" name="girls" min="0" max="20" inputmode="numeric"></label>
                <label>{{ f.girls_ages }}<input type="text" name="girls_ages" placeholder="{{ f.ages_placeholder }}"></label>
              </div>
            </fieldset>

            <fieldset class="form-part">
              <legend>{{ f.section_plans }}</legend>
              <fieldset class="choices">
                <legend>{{ f.stage }}</legend>
                {%- for opt in f.stage_options %}
                <label class="choice"><input type="radio" name="stage" value="{{ opt }}"{% if loop.first %} checked{% endif %}> {{ opt }}</label>
                {%- endfor %}
              </fieldset>
              <div class="row">
                <label>{{ f.interest }}
                  <select name="interest">
                    <option value="">{{ f.situation_placeholder }}</option>
                    {%- for opt in f.interest_options %}
                    <option>{{ opt }}</option>
                    {%- endfor %}
                  </select>
                </label>
                <label>{{ f.timeframe }}
                  <select name="timeframe">
                    <option value="">{{ f.situation_placeholder }}</option>
                    {%- for opt in f.timeframe_options %}
                    <option>{{ opt }}</option>
                    {%- endfor %}
                  </select>
                </label>
              </div>
              <fieldset class="choices">
                <legend>{{ f.temp_housing }}</legend>
                <div class="choices-inline">
                  {%- for opt in f.temp_housing_options %}
                  <label class="choice"><input type="radio" name="temp_housing" value="{{ opt }}"> {{ opt }}</label>
                  {%- endfor %}
                </div>
              </fieldset>
              <label>{{ f.help }}<input type="text" name="help"></label>
              <label>{{ f.message }}<textarea name="message" rows="3"></textarea></label>
              <label class="choice consent-check"><input type="checkbox" name="amana" value="Yes"> {{ f.amana }}</label>
            </fieldset>

            <button class="btn btn-solid btn-block" type="submit">{{ f.button }}</button>
            <p class="form-consent">{{ f.consent }}</p>
            <p class="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <p class="footer-close" lang="he" dir="rtl">{{ s.join.closing }}</p>
      <p>© <span id="year"></span> {{ s.meta.brand }} · {{ s.footer.text }}</p>
      <p><a href="mailto:{{ s.join.email }}">{{ s.join.email }}</a> · <a href="{{ s.meta.brochure }}" download>{{ s.footer.brochure_label }}</a></p>
    </div>
  </footer>

  <script src="/script.js"></script>
</body>
</html>
